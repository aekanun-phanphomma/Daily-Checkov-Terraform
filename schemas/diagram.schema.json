{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM diagram spec: one attack path, one control, one fix",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "attacker", "gate", "target", "attack_label",
               "risk_callout", "control_callout", "code_diff"],
  "$defs": {
    "label": {"type": "string", "minLength": 1, "maxLength": 22}
  },
  "properties": {
    "title": {"type": "string", "minLength": 5, "maxLength": 60},
    "attacker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": {"enum": ["internet", "user"]},
        "label": {"$ref": "#/$defs/label"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {"label": {"$ref": "#/$defs/label"}}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {"label": {"$ref": "#/$defs/label"}}
    },
    "ally": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {"label": {"$ref": "#/$defs/label"}}
    },
    "attack_label": {"type": "string", "minLength": 1, "maxLength": 28},
    "risk_callout": {"type": "string", "minLength": 5, "maxLength": 90},
    "control_callout": {"type": "string", "minLength": 5, "maxLength": 90},
    "code_diff": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "items": {"type": "string", "pattern": "^[-+] [^ ]", "maxLength": 80}
    }
  }
}
